# =========================
# CORE APP
# =========================
NODE_ENV=development
APP_NAME=quorvexa-platform
APP_URL=http://localhost:3000
API_GATEWAY_URL=http://localhost:4000

# =========================
# AUTH
# =========================
JWT_SECRET=change-me-to-a-strong-random-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-to-a-different-strong-random-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback

# =========================
# DATABASE
# =========================
DATABASE_URL=postgresql://quorvexa:quorvexa_dev_pass@localhost:5432/quorvexa_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=quorvexa
POSTGRES_PASSWORD=quorvexa_dev_pass
POSTGRES_DB=quorvexa_db

# =========================
# REDIS
# =========================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL=3600

# =========================
# AI / LLM
# =========================
LLM_PROVIDER=local
OPENAI_API_KEY=
OPENAI_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3
EMBEDDING_MODEL=all-MiniLM-L6-v2
OLLAMA_HOST=http://localhost:11434
MAX_TOKENS=4096
TEMPERATURE=0.7

# =========================
# VECTOR DB (Qdrant)
# =========================
VECTOR_DB_URL=http://localhost:6333
VECTOR_DB_API_KEY=
VECTOR_DB_COLLECTION=quorvexa_embeddings

# =========================
# AWS (Optional - for cloud deployment)
# =========================
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=quorvexa-assets

# =========================
# AZURE (Optional - for cloud deployment)
# =========================
AZURE_REGION=southeastasia
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_KEY=
AZURE_STORAGE_CONTAINER=quorvexa-assets

# =========================
# OBSERVABILITY
# =========================
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
ELASTICSEARCH_URL=http://localhost:9200
KIBANA_URL=http://localhost:5601
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=quorvexa-platform

# =========================
# MESSAGING
# =========================
KAFKA_BROKER=localhost:9092
KAFKA_GROUP_ID=quorvexa-consumers
RABBITMQ_URL=amqp://quorvexa:quorvexa_pass@localhost:5672
RABBITMQ_VHOST=quorvexa

# =========================
# RATE LIMITING
# =========================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
RATE_LIMIT_SKIP_SUCCESSFUL=false

# =========================
# MULTI-TENANCY
# =========================
DEFAULT_TENANT_ID=default
MAX_TENANTS=100

# =========================
# TESTING
# =========================
TEST_DATABASE_URL=postgresql://quorvexa:quorvexa_dev_pass@localhost:5432/quorvexa_test
E2E_BASE_URL=http://localhost:3000
E2E_API_URL=http://localhost:4000

# =========================
# DOCKER
# =========================
DOCKER_REGISTRY=ghcr.io/quorvexa
DOCKER_TAG=latest

# =========================
# SECURITY
# =========================
CORS_ORIGINS=http://localhost:3000,http://localhost:4000
COOKIE_SECRET=change-me-cookie-secret-min-32-chars
ENCRYPTION_KEY=change-me-encryption-key-32-chars
AUDIT_LOG_ENABLED=true
