# Notification Service Environment Variables
# Copy to .env and fill in values. These are also available from the monorepo root .env.

# --- Required ---
NODE_ENV=development
DATABASE_URL=postgresql://quorvexa:quorvexa_dev_pass@localhost:5433/quorvexa_db
JWT_SECRET=change-me-to-a-strong-random-secret-min-32-chars

# --- Optional (with defaults) ---
PORT=3004
CORS_ORIGINS=http://localhost:3000,http://localhost:4000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# --- Email (SMTP) ---
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@quorvexa.dev

# --- Slack (optional, required for slack channel) ---
SLACK_WEBHOOK_URL=
SLACK_APP_ID=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_VERIFICATION_TOKEN=
