# Auth Service Environment Variables
# Copy to .env and fill in values. These are also available from the monorepo root .env.

# --- Required ---
NODE_ENV=development
DATABASE_URL=postgresql://quorvexa:quorvexa_dev_pass@localhost:5433/quorvexa_db
JWT_SECRET=change-me-to-a-strong-random-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-to-a-different-strong-random-secret

# --- Optional (with defaults) ---
PORT=3001
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGINS=http://localhost:3000,http://localhost:4000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# --- OAuth (optional, leave blank to skip) ---
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback
