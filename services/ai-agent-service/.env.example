# AI Agent Service Environment Variables (Python / FastAPI)
# Copy to .env and fill in values. These are also available from the monorepo root .env.
# pydantic-settings reads this file automatically.

# --- Required (none — all have defaults for local dev) ---

# --- General ---
ENVIRONMENT=development
PORT=3005

# --- LLM ---
LLM_PROVIDER=local
OPENAI_API_KEY=
OPENAI_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3
EMBEDDING_MODEL=all-MiniLM-L6-v2
OLLAMA_HOST=http://localhost:11434
MAX_TOKENS=4096
TEMPERATURE=0.7

# --- Vector DB (Qdrant) ---
VECTOR_DB_URL=http://localhost:6333
VECTOR_DB_API_KEY=
VECTOR_DB_COLLECTION=quorvexa_embeddings

# --- Redis (agent memory / sessions) ---
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=quorvexa_redis_dev
REDIS_DB=0

# --- Security ---
JWT_SECRET=change-me-to-a-strong-random-secret-min-32-chars
CORS_ORIGINS=http://localhost:3000,http://localhost:4000

# --- Observability ---
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
