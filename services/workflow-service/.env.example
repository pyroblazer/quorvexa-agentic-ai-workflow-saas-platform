# Workflow Service Environment Variables
# Copy to .env and fill in values. These are also available from the monorepo root .env.

# --- Required ---
NODE_ENV=development
DATABASE_URL=postgresql://quorvexa:quorvexa_dev_pass@localhost:5433/quorvexa_db
JWT_SECRET=change-me-to-a-strong-random-secret-min-32-chars

# --- Optional (with defaults) ---
PORT=3003
KAFKA_BROKER=localhost:9092
AI_AGENT_SERVICE_URL=http://localhost:3005
NOTIFICATION_SERVICE_URL=http://localhost:3004
CORS_ORIGINS=http://localhost:3000,http://localhost:4000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
LOG_LEVEL=info
