{
  "name": "@quorvexa/sdk",
  "version": "1.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc -w",
    "test": "jest --passWithNoTests",
    "test:unit": "jest --testPathPattern=\\.spec\\.ts$ --passWithNoTests",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist coverage"
  },
  "devDependencies": {
    "@quorvexa/config": "workspace:*",
    "@types/node": "^20.17.10",
    "jest": "^29.7.0",
    "rimraf": "^5.0.10",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": ["ts-jest", { "tsconfig": { "esModuleInterop": true } }]
    },
    "coverageDirectory": "../coverage",
    "collectCoverageFrom": ["**/*.ts", "!**/*.spec.ts"]
  }
}
